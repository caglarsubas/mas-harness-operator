{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:planeon:internal:native-qualification-capture:v5",
 "oneOf": [
  {
   "$ref": "#/$defs/capture"
  },
  {
   "$ref": "#/$defs/lifecycleCapture"
  },
  {
   "$ref": "#/$defs/backendCapture"
  }
 ],
 "$defs": {
  "digest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "path": {
   "type": "string",
   "minLength": 1,
   "maxLength": 4096,
   "pattern": "^/[A-Za-z0-9_./+-]+$"
  },
  "time": {
   "type": "string",
   "minLength": 1,
   "maxLength": 20,
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
  },
  "namespaces": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "user",
    "mnt",
    "pid",
    "net"
   ],
   "properties": {
    "user": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "mnt": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "pid": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "net": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    }
   }
  },
  "segment": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "offset",
    "length",
    "permissions"
   ],
   "properties": {
    "offset": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "length": {
     "type": "integer",
     "minimum": 1,
     "maximum": 67108864
    },
    "permissions": {
     "enum": [
      "r-xp",
      "r-xs",
      "--xp",
      "--xs"
     ]
    }
   }
  },
  "fileEntry": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "mode",
    "size",
    "sha256",
    "verityDigest",
    "executableSegments"
   ],
   "properties": {
    "path": {
     "$ref": "#/$defs/path"
    },
    "mode": {
     "enum": [
      "0444",
      "0555"
     ]
    },
    "size": {
     "type": "integer",
     "minimum": 1,
     "maximum": 67108864
    },
    "sha256": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "verityDigest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "executableSegments": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/segment"
     },
     "minItems": 0,
     "maxItems": 16
    }
   }
  },
  "fileObservation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "entry",
    "device",
    "inode",
    "uid",
    "gid",
    "nlink",
    "contentDigest",
    "measuredVerity"
   ],
   "properties": {
    "entry": {
     "$ref": "#/$defs/fileEntry"
    },
    "device": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "inode": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "uid": {
     "const": 0
    },
    "gid": {
     "const": 0
    },
    "nlink": {
     "const": 1
    },
    "contentDigest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "measuredVerity": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    }
   }
  },
  "mapping": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "offset",
    "length",
    "permissions",
    "device",
    "inode"
   ],
   "properties": {
    "path": {
     "$ref": "#/$defs/path"
    },
    "offset": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "length": {
     "type": "integer",
     "minimum": 1,
     "maximum": 67108864
    },
    "permissions": {
     "enum": [
      "r-xp",
      "r-xs",
      "--xp",
      "--xs"
     ]
    },
    "device": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "inode": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    }
   }
  },
  "observedRoleCgroup": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "inode",
    "memoryMaxBytes",
    "pidsMax",
    "cpuQuotaMicros",
    "cpuPeriodMicros"
   ],
   "properties": {
    "path": {
     "$ref": "#/$defs/path"
    },
    "inode": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "memoryMaxBytes": {
     "type": "integer",
     "minimum": 1048576,
     "maximum": 1099511627776
    },
    "pidsMax": {
     "type": "integer",
     "minimum": 1,
     "maximum": 4096
    },
    "cpuQuotaMicros": {
     "type": "integer",
     "minimum": 1000,
     "maximum": 1000000
    },
    "cpuPeriodMicros": {
     "type": "integer",
     "minimum": 1000,
     "maximum": 1000000
    }
   }
  },
  "observerCgroup": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "inode",
    "memoryMaxBytes",
    "pidsMax",
    "cpuQuotaMicros",
    "cpuPeriodMicros"
   ],
   "properties": {
    "inode": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "memoryMaxBytes": {
     "type": "integer",
     "minimum": 1048576,
     "maximum": 1099511627776
    },
    "pidsMax": {
     "type": "integer",
     "minimum": 1,
     "maximum": 4096
    },
    "cpuQuotaMicros": {
     "type": "integer",
     "minimum": 1000,
     "maximum": 1000000
    },
    "cpuPeriodMicros": {
     "type": "integer",
     "minimum": 1000,
     "maximum": 1000000
    }
   }
  },
  "programInfo": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "programId",
    "programType",
    "translatedSha256",
    "instructionBytes",
    "mapIds",
    "ifindex",
    "pinPath",
    "attachFlags",
    "helperCalls"
   ],
   "properties": {
    "programId": {
     "type": "integer",
     "minimum": 1,
     "maximum": 4294967295
    },
    "programType": {
     "enum": [
      9,
      18
     ]
    },
    "translatedSha256": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instructionBytes": {
     "type": "integer",
     "minimum": 8,
     "maximum": 65536
    },
    "mapIds": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "minItems": 0,
     "maxItems": 0
    },
    "ifindex": {
     "const": 0
    },
    "pinPath": {
     "$ref": "#/$defs/path"
    },
    "attachFlags": {
     "const": "BPF_F_ALLOW_MULTI"
    },
    "helperCalls": {
     "const": 0
    }
   }
  },
  "observedProgram": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "program",
    "pinPath",
    "localIds",
    "effectiveIds"
   ],
   "properties": {
    "program": {
     "$ref": "#/$defs/programInfo"
    },
    "pinPath": {
     "$ref": "#/$defs/path"
    },
    "localIds": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
     },
     "minItems": 1,
     "maxItems": 16,
     "uniqueItems": true
    },
    "effectiveIds": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
     },
     "minItems": 1,
     "maxItems": 16,
     "uniqueItems": true
    }
   }
  },
  "roleProcess": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "pid",
    "startTicks",
    "uid",
    "gid",
    "processLabel",
    "cgroup",
    "seccompMode",
